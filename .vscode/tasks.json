{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: List Boards",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": ["board", "list"],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Compile (ESP8266)",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "compile",
        "--fqbn",
        "${config:cueLight.fqbn}",
        "--build-path",
        "${workspaceFolder}/build/nodemcu",
        "--jobs",
        "0",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "arduino",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Arduino: Upload firmware → Board 0001",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "upload",
        "--fqbn",
        "${config:cueLight.fqbn}",
        "--port",
        "${config:cueLight.board1.port}",
        "--input-dir",
        "${workspaceFolder}/build/nodemcu"
      ],
      "dependsOn": ["Arduino: Compile (ESP8266)"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload firmware → Board 83430",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "upload",
        "--fqbn",
        "${config:cueLight.fqbn}",
        "--port",
        "${config:cueLight.board2.port}",
        "--input-dir",
        "${workspaceFolder}/build/nodemcu"
      ],
      "dependsOn": ["Arduino: Compile (ESP8266)"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload firmware → Both Boards",
      "type": "shell",
      "command": "make",
      "args": ["upload-both"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload LittleFS → Board 0001",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/upload-littlefs.sh",
      "args": ["--port", "${config:cueLight.board1.port}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload LittleFS → Board 83430",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/upload-littlefs.sh",
      "args": ["--port", "${config:cueLight.board2.port}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload LittleFS → Both Boards",
      "type": "shell",
      "command": "make",
      "args": ["littlefs-both"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Full Deploy → Board 0001",
      "dependsOn": [
        "Arduino: Upload firmware → Board 0001",
        "Arduino: Upload LittleFS → Board 0001"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Full Deploy → Board 83430",
      "dependsOn": [
        "Arduino: Upload firmware → Board 83430",
        "Arduino: Upload LittleFS → Board 83430"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Full Deploy → Both Boards",
      "type": "shell",
      "command": "make",
      "args": ["deploy-both"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Serial Monitor → Board 0001",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "monitor",
        "--port",
        "${config:cueLight.board1.port}",
        "--config",
        "baudrate=${config:cueLight.baud}"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Serial Monitor → Board 83430",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "monitor",
        "--port",
        "${config:cueLight.board2.port}",
        "--config",
        "baudrate=${config:cueLight.baud}"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Compile (Heltec V3)",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "compile",
        "--fqbn",
        "${config:cueLight.heltec.fqbn}",
        "--build-path",
        "${workspaceFolder}/build/heltec",
        "--jobs",
        "0",
        "${workspaceFolder}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "arduino",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Arduino: Upload firmware → Heltec V3",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "upload",
        "--fqbn",
        "${config:cueLight.heltec.fqbn}",
        "--port",
        "${config:cueLight.heltec.port}",
        "--input-dir",
        "${workspaceFolder}/build/heltec"
      ],
      "dependsOn": ["Arduino: Compile (Heltec V3)"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Serial Monitor → Heltec V3",
      "type": "shell",
      "command": "${config:cueLight.cli}",
      "args": [
        "monitor",
        "--port",
        "${config:cueLight.heltec.port}",
        "--config",
        "baudrate=${config:cueLight.baud}"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
